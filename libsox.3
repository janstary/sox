.Os
.Sh NAME
.Nm libsox
.Nd audio file-format and effect library
.Sh SYNOPSIS
.In sox.h
.Pp
.Ft int
.Fn sox_init "void"
.Ft void
.Fn sox_quit "void"
.Ft sox_format_t *
.Fn sox_open_read "char const * path" "sox_signalinfo_t const * signal" "sox_encodinginfo_t const * encoding" "char const * filetype"
.Ft sox_format_t *
.Fn sox_open_write "char const * path" "sox_signalinfo_t const * signal" "sox_encodinginfo_t const * encoding" "char const * filetype" "sox_oob_t const * oob" "sox_bool (*overwrite)(char const *)"
.Ft size_t
.Fn sox_read "sox_format_t * format" "sox_sample_t * buf" "size_t len"
