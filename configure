#!/bin/sh

# Copyright (c) 2014-2021 Ingo Schwarze <schwarze@openbsd.org>
# Copyright (c) 2024 Jan Starý <hans@stare.cz>

set -e

[ -w config.log ] && mv config.log config.log.old
[ -w config.h   ] && mv config.h config.h.old

# Output file descriptor usage:
# 1 (stdout): config.h, Makefile.local
# 2 (stderr): original stderr, usually to the console
# 3: config.log

exec 3> config.log
echo "writing config.log"

# default settings

CC=cc
CFLAGS=
CPPFLAGS=
LDFLAGS=
FATAL=0
ADDOBJS=
ADDLIBS=
DEVOBJS=
DEVLIBS=

# optional external libraries
HAVE_AMRNB=
HAVE_AMRWB=
HAVE_AMRVO=
HAVE_FLAC=
HAVE_GSM=
HAVE_ID3=
HAVE_LADSPA=
HAVE_LAME=
HAVE_LPC=
HAVE_LTDL=
HAVE_MAD=
HAVE_MAGIC=
HAVE_OGG=
HAVE_OPUS=
HAVE_PNG=
HAVE_SNDFILE=
HAVE_SPEEXDSP=
HAVE_TWOLAME=
HAVE_VORBIS=
HAVE_WAVPACK=
HAVE_ZLIB=

# optional audio drivers
HAVE_ALSA=
HAVE_AO=
HAVE_COREAUDIO=
HAVE_OSS=
HAVE_PORTAUDIO=
HAVE_PULSEAUDIO=
HAVE_SNDIO=
HAVE_SUNAUDIO=

PREFIX="/usr/local"
BINDIR=
MANDIR=

INSTALL="install"
LN="ln -sf"

# manual settings?

if [ -r ./configure.local ]; then
	echo "reading configure.local" 1>&2
	echo "reading configure.local" 1>&3
	cat ./configure.local 1>&3
	. ./configure.local
else
	echo "no configure.local: fully automatic configuration" 1>&2
	echo "no configure.local: fully automatic configuration" 1>&3
fi
echo 1>&3

# the testing functions

# Check whether this HAVE_ setting is manually overridden.
# If yes, use the override, if no, do not decide anything yet.
# Arguments: test file name, test var name, manual value
ismanual() {
	[ -z "${3}" ] && return 1
	echo "tested ${1}: HAVE_${2}=${3} (manual)" 1>&2
	echo "tested ${1}: HAVE_${2}=${3} (manual)" 1>&3
	echo 1>&3
	return 0
}

# Run a single autoconfiguration test.
# In case of success, enable the feature.
# In case of failure, do not decide anything yet.
# Arguments: test file name, test var name, additional CFLAGS
singletest() {
	n=${1}${3}
	cat 1>&3 << __HEREDOC__
testing ${n} ...
${COMP} -o have-${1} have-${1}.c ${3}
__HEREDOC__

	if ${COMP} -o "have-${1}" "have-${1}.c" ${3} 1>&3 2>&3
	then
		echo "partial result of ${n}: ${CC} succeeded" 1>&3
	else
		echo "tested ${n}: no (compilation failed)" 1>&2
		echo "result of ${n}: ${CC} failed with exit status $?" 1>&3
		echo "result of compiling ${n}: no" 1>&3
		echo 1>&3
		return 1
	fi

	if ./have-${1} 1>&3 2>&3; then
		echo "tested ${n}: yes" 1>&2
		echo "result of running ${n}: yes" 1>&3
		echo 1>&3
		eval HAVE_${2}=1
		rm "have-${1}"
		return 0
	else
		echo "tested ${n}: no (execution failed)" 1>&2
		echo "result of ${n}: execution failed with exit status $?" 1>&3
		echo "result of running ${n}: no" 1>&3
		echo 1>&3
		rm "have-${1}"
		return 1
	fi
}

# Run a complete autoconfiguration test, including the check for
# a manual override and disabling the feature on failure.
# Arguments: test file name, test var name, additional CFLAGS
# The final argument can optionally be repeated a second time.
runtest() {
	eval _manual=\${HAVE_${2}}
	ismanual "${1}" "${2}" "${_manual}" && return 0
	singletest "${1}" "${2}" "${3}" && return 0
	[ -n "${4}" ] && singletest "${1}" "${2}" "${4}" && return 0
	eval HAVE_${2}=0
	return 1
}

# compiler options

DEFCFLAGS="-g -W -Wall -Wmissing-prototypes -Wstrict-prototypes -Wwrite-strings -Wno-unused-parameter"

if [ -n "${CFLAGS}" ]; then
	COMP="${CC} ${CFLAGS} -Wno-unused -Werror"
else
	COMP="${CC} ${DEFCFLAGS} -Wno-unused -Werror"
fi

if [ -n "${CFLAGS}" ]; then
	echo "CFLAGS specified manually:" 1>&3
else
	CFLAGS="${DEFCFLAGS}"
fi

echo "selected CFLAGS=\"${CFLAGS}\"" 1>&2
echo "selected CFLAGS=\"${CFLAGS}\"" 1>&3
echo 1>&3

COMP="${CC} ${CFLAGS} ${CPPFLAGS} ${LDFLAGS}"

# detect optional formats
runtest amrnb	AMRNB  -lopencore-amrnb	|| true
runtest amrwb	AMRWB  -lopencore-amrwb	|| true
runtest amrvo	AMRVO  -lvo-amrwbenc	|| true
runtest flac	FLAC    -lFLAC		|| true
runtest gsm	GSM     -lgsm		|| true
runtest id3	ID3     -lid3tag	|| true
runtest ladspa	LADSPA  		|| true
runtest lame	LAME    -lmp3lame	|| true
runtest lpc	LPC	-llpc		|| true
runtest ltdl	LTDL	-lltdl		|| true
runtest mad	MAD     -lmad		|| true
runtest magic	MAGIC   -lmagic		|| true
runtest ogg	OGG     -logg		|| true
runtest opus	OPUS  -lopus -lopusfile	|| true
runtest png	PNG     -lpng		|| true
runtest sndfile	SNDFILE -lsndfile	|| true
runtest speexdsp SPEEXDSP -lspeexdsp	|| true
runtest twolame	TWOLAME -ltwolame	|| true
runtest vorbis	VORBIS  -lvorbis	|| true
runtest wavpack	WAVPACK -lwavpack	|| true
runtest zlib	ZLIB    -lz		|| true

# detect optional audio devices/drivers
runtest alsa		ALSA        -lasound			|| true
runtest ao		AO          -lao			|| true
runtest coreaudio	COREAUDIO   -Wl,-framework,CoreAudio	|| true
runtest oss		OSS					|| true
runtest portaudio	PORTAUDIO				|| true
runtest pulseaudio	PULSEAUDIO  -lpulse-simple		|| true
runtest sndio		SNDIO       -lsndio			|| true
runtest sunaudio	SUNAUDIO				|| true

[ "${FATAL}" -eq 0 ] || exit 1

# are we linking extra libraries?

ADDLIBS="${ADDLIBS} -lm"

if [ ${HAVE_AMRNB} -eq 1 ]; then
	ADDOBJS="${ADDOBJS} amr-nb.o"
	ADDLIBS="${ADDLIBS} -lopencore-amrnb"
fi

if [ ${HAVE_AMRWB} -eq 1 -o ${HAVE_AMRVO} -eq 1 ]; then
	[ ${HAVE_AMRWB} -eq 1 ] && ADDLIBS="${ADDLIBS} -lopencore-amrwb"
	[ ${HAVE_AMRVO} -eq 1 ] && ADDLIBS="${ADDLIBS} -lvo-amrwbenc"
	ADDOBJS="${ADDOBJS} amr-wb.o"
fi

if [ ${HAVE_FLAC} -eq 1 ]; then
	ADDOBJS="${ADDOBJS} flac.o"
	ADDLIBS="${ADDLIBS} -lFLAC"
fi

if [ ${HAVE_GSM} -eq 1 ]; then
	ADDOBJS="${ADDOBJS} gsm.o"
	ADDLIBS="${ADDLIBS} -lgsm"
fi

if [ ${HAVE_ID3} -eq 1 ]; then
	ADDOBJS="${ADDOBJS} id3.o"
	ADDLIBS="${ADDLIBS} -lid3tag"
fi

if [ ${HAVE_LADSPA} -eq 1 -a ${HAVE_LTDL} -eq 1 ]; then
	ADDOBJS="${ADDOBJS} ladspa.o"
	ADDLIBS="${ADDLIBS} -lltdl"
fi

if [ ${HAVE_LAME} -eq 1 -o ${HAVE_TWOLAME} -eq 1 -o ${HAVE_MAD} -eq 1 ]; then
	[ ${HAVE_MAD} -eq 1     ] && ADDLIBS="${ADDLIBS} -lmad"
	[ ${HAVE_LAME} -eq 1    ] && ADDLIBS="${ADDLIBS} -lmp3lame"
	[ ${HAVE_TWOLAME} -eq 1 ] && ADDLIBS="${ADDLIBS} -ltwolame"
	ADDOBJS="${ADDOBJS} mp3.o"
fi

if [ ${HAVE_LPC} -eq 1 ]; then
	ADDOBJS="${ADDOBJS} lpc10.o"
	ADDLIBS="${ADDLIBS} -llpc"
fi

if [ ${HAVE_MAGIC} -eq 1 ]; then
	ADDLIBS="${ADDLIBS} -lmagic"
	# no extra *.o file
fi

if [ ${HAVE_OGG} -eq 1 ]; then
	if [ ${HAVE_OPUS} -eq 1 ]; then
		ADDOBJS="${ADDOBJS} opus.o"
		ADDLIBS="${ADDLIBS} -lopus -lopusfile"
	fi
	if [ ${HAVE_VORBIS} -eq 1 ]; then
		ADDOBJS="${ADDOBJS} vorbis.o"
		ADDLIBS="${ADDLIBS} -lvorbis -lvorbisfile -lvorbisenc"
	fi
	ADDLIBS="${ADDLIBS} -logg"
fi

if [ ${HAVE_PNG} -eq 1 -a ${HAVE_ZLIB} -eq 1 ]; then
	ADDOBJS="${ADDOBJS} spectrogram.o"
	ADDLIBS="${ADDLIBS} -lpng -lz"
fi

if [ ${HAVE_SNDFILE} -eq 1 ]; then
	ADDOBJS="${ADDOBJS} sndfile.o caf.o fap.o mat4.o mat5.o"
	ADDOBJS="${ADDOBJS} paf.o pvf.o sd2.o w64.o xi.o"
	ADDLIBS="${ADDLIBS} -lsndfile"
fi

if [ ${HAVE_SPEEXDSP} -eq 1 ]; then
	ADDOBJS="${ADDOBJS} speexdsp.o"
	ADDLIBS="${ADDLIBS} -lspeexdsp"
fi

if [ ${HAVE_WAVPACK} -eq 1 ]; then
	ADDOBJS="${ADDOBJS} wavpack.o"
	ADDLIBS="${ADDLIBS} -lwavpack"
fi

if [ ${HAVE_ALSA} -eq 1 ]; then
	DEVOBJS="${DEVOBJS} alsa.o"
	DEVLIBS="${DEVLIBS} -lasound"
fi

if [ ${HAVE_AO} -eq 1 ]; then
	DEVOBJS="${DEVOBJS} ao.o"
	DEVLIBS="${DEVLIBS} -lao"
fi

if [ ${HAVE_COREAUDIO} -eq 1 ]; then
	DEVOBJS="${DEVOBJS} coreaudio.o"
	DEVLIBS="${DEVLIBS} -Wl,-framework,CoreAudio"
fi

if [ ${HAVE_PULSEAUDIO} -eq 1 ]; then
	DEVOBJS="${DEVOBJS} pulseaudio.o"
	DEVLIBS="${DEVLIBS} -lpulse -lpulse-simple"
fi

if [ ${HAVE_SNDIO} -eq 1 ]; then
	DEVOBJS="${DEVOBJS} sndio.o"
	DEVLIBS="${DEVLIBS} -lsndio"
fi

if [ ${HAVE_SUNAUDIO} -eq 1 ]; then
	DEVOBJS="${DEVOBJS} sunaudio.o"
	# no extra lib needed
fi

echo "extra libs: ${ADDLIBS}" 1>&2
echo "extra libs: ${ADDLIBS}" 1>&3
echo "driver libs: ${DEVLIBS}" 1>&2
echo "driver libs: ${DEVLIBS}" 1>&3
echo 1>&3

# write config.h

exec > config.h

echo
cat << __HEREDOC__
#define HAVE_AMRNB	${HAVE_AMRNB}
#define HAVE_AMRWB	${HAVE_AMRWB}
#define HAVE_AMRVO	${HAVE_AMRVO}
#define HAVE_FLAC	${HAVE_FLAC}
#define HAVE_GSM	${HAVE_GSM}
#define HAVE_ID3	${HAVE_ID3}
#define HAVE_LADSPA	${HAVE_LADSPA}
#define HAVE_LAME	${HAVE_LAME}
#define HAVE_LPC	${HAVE_LPC}
#define HAVE_LTDL	${HAVE_LTDL}
#define HAVE_MAD	${HAVE_MAD}
#define HAVE_MAGIC	${HAVE_MAGIC}
#define HAVE_OGG	${HAVE_OGG}
#define HAVE_OPUS	${HAVE_OPUS}
#define HAVE_PNG	${HAVE_PNG}
#define HAVE_SNDFILE	${HAVE_SNDFILE}
#define HAVE_SPEEXDSP	${HAVE_SPEEXDSP}
#define HAVE_TWOLAME	${HAVE_TWOLAME}
#define HAVE_VORBIS	${HAVE_VORBIS}
#define HAVE_WAVPACK	${HAVE_WAVPACK}
#define HAVE_ZLIB	${HAVE_ZLIB}

#define HAVE_ALSA	${HAVE_ALSA}
#define HAVE_AO		${HAVE_AO}
#define HAVE_COREAUDIO	${HAVE_COREAUDIO}
#define HAVE_OSS	${HAVE_OSS}
#define HAVE_PORTAUDIO	${HAVE_PORTAUDIO}
#define HAVE_PULSEAUDIO	${HAVE_PULSEAUDIO}
#define HAVE_SNDIO	${HAVE_SNDIO}
#define HAVE_SUNAUDIO	${HAVE_SUNAUDIO}
__HEREDOC__

echo "config.h written" 1>&2
echo "config.h written" 1>&3

# write Makefile.local

exec > Makefile.local

[ -z "${BINDIR}" ] && BINDIR="${PREFIX}/bin"
[ -z "${MANDIR}" ] && MANDIR="${PREFIX}/man"

cat << __HEREDOC__
PREFIX	= ${PREFIX}
BINDIR	= ${BINDIR}
MANDIR	= ${MANDIR}

CC	= ${CC}
CFLAGS	= ${CFLAGS}
CPPFLAGS= ${CPPFLAGS}
LDFLAGS	= ${LDFLAGS}

INSTALL = ${INSTALL}
LN	= ${LN}

CPTOBJS	= ${CPTOBJS}
ADDOBJS	= ${ADDOBJS}
ADDLIBS	= ${ADDLIBS}
DEVOBJS	= ${DEVOBJS}
DEVLIBS	= ${DEVLIBS}
__HEREDOC__

echo "Makefile.local written" 1>&2
echo "Makefile.local written" 1>&3

exit 0
